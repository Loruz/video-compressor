{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Compressor",
  "version": "0.1.0",
  "identifier": "com.local.videocompressor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Compressor",
        "width": 760,
        "height": 560,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
